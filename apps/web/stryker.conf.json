{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/lib/**/*.ts",
    "src/ui/**/*.tsx",
    "src/app/**/*.tsx",
    "!src/**/*.test.*",
    "!src/app/Root.tsx",
    "!src/app/StudentLayout.tsx",
    "!src/ui/Sheet.tsx",
    "!src/lib/paper.ts",
    "!src/lib/scanner.ts",
    "!src/lib/gmail.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 45
  },
  "plugins": [
    "./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"
  ],
  "_comment": "Gates as a ratchet, not a target. The scoped baseline is ~50%: app/ and ui/ are JSX composition with almost no mutant coverage, and lib/ sits at ~62%. `break` is just under the baseline so a regression fails CI while `low`/`high` stay the targets; raise `break` as tests land."
}
