{
  "name": "@skoolie/web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "astryx theme build src/theme.ts",
    "prebuild": "pnpm theme:build",
    "build:demo": "VITE_DEMO=1 vite build --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --port 4173 --strictPort",
    "shots": "node scripts/screenshots.mjs",
    "test:env": "node scripts/env-matrix.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.0",
    "@astryxdesign/theme-neutral": "0.5.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@skoolie/shared": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "unplugin": "^3.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
