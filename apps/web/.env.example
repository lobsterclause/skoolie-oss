# Copy to apps/web/.env. Vite exposes VITE_* to the browser, so these are public Firebase web
# config values (not secrets); access is enforced by Firestore rules + the Auth allowlist, never
# by hiding these. Get them from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The Firestore document id under families/. Any slug you like — one per household.
VITE_SKOOLIE_FAMILY_ID=family

# Your district's Home Access Center origin, the same value as the collector's HAC_BASE_URL.
# Only used to build the "Open in HAC" deep link when an assignment carries no URL of its own.
# Leave empty and that button is simply not shown.
VITE_HAC_BASE_URL=

# The school's IANA timezone. Attendance and "due today" are calendar-day questions, so they are
# answered in the school's zone, not the viewer's. Must match the collector's SKOOLIE_TZ.
VITE_SKOOLIE_TZ=America/Chicago

# Set to 1 to point the app at local emulators (auth 9099, firestore 8080)
VITE_USE_EMULATORS=0
