{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/testing/**",
    "!src/adapters/**",
    "!src/scripts/**",
    "!src/links/imap.ts",
    "!src/run.ts",
    "!src/links/index.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 85
  },
  "plugins": [
    "./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"
  ],
  "_comment": "Gates as a ratchet, not a target. The scoped baseline is ~89% (collector unit tests, recorded in the 'cover the collector's Firestore and Graph glue' commit). `break` sits just under the baseline so a regression fails CI while `low`/`high` stay the targets; raise `break` as tests land."
}
