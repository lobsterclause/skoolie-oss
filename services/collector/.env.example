# Copy to services/collector/.env for local runs, or to /opt/skoolie/.env on the host that runs the
# timer (chmod 0600). Never commit real values — .env is gitignored.

# --- Required ---------------------------------------------------------------
# The Firestore document id under families/. Any slug you like — one per household.
SKOOLIE_FAMILY_ID=family
# Your district's Home Access Center origin. Find it by signing in to HAC in a browser and copying
# the scheme + host, e.g. https://hac.example-isd.org. There is no default: this is district-specific.
HAC_BASE_URL=
# The same HAC parent credentials you use in the browser. Read-only: the collector never writes to HAC.
HAC_USERNAME=
HAC_PASSWORD=
# Firebase Admin: path to a service-account JSON (mounted read-only into the container).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json
# The school's IANA timezone — resolves "today" and relative dates ("this Friday") in mail.
# Must match the web app's VITE_SKOOLIE_TZ.
SKOOLIE_TZ=America/Chicago

# --- HAC session + scratch state --------------------------------------------
# HAC session cookies are cached here so runs reuse one login instead of re-authenticating.
SKOOLIE_SESSION_FILE=/data/profile/hac-session.json
# Stagehand persistent browser profile (only the optional campus-scraper scripts use this).
SKOOLIE_PROFILE_DIR=/data/profile
# Where raw HTML dumps go when --dump is passed. Contains student PII; never committed.
SKOOLIE_DUMP_DIR=/data/dumps

# --- Optional: teacher-link harvester and inbox (--adapter links / outlook) --
# Comma list of your district's mail domains. Empty means the mail adapters harvest nothing.
SKOOLIE_SCHOOL_DOMAINS=
# Preferred mail source: a Microsoft 365 mailbox via Graph (read-only Mail.Read), which works where
# password IMAP is disabled. Entra app registration, public client, device-code flow — see docs/runbook.md.
SKOOLIE_GRAPH_CLIENT_ID=
SKOOLIE_GRAPH_TENANT_ID=organizations
SKOOLIE_GRAPH_TOKEN_CACHE=/data/profile/msal-cache.json
# Alternative mail source: any IMAP mailbox receiving school mail.
# Gmail: imap.gmail.com + a Google "app password" (2-step verification required). Read-only access.
SKOOLIE_IMAP_HOST=
SKOOLIE_IMAP_PORT=993
SKOOLIE_IMAP_USER=
SKOOLIE_IMAP_PASS=
SKOOLIE_IMAP_MAILBOX=INBOX
SKOOLIE_LINKS_DAYS=45
SKOOLIE_INBOX_DAYS=14
# Extra senders that count as school mail, comma separated (e.g. a parent who forwards teacher email).
SKOOLIE_INBOX_SENDERS=
# Cap on messages classified per run; the rest wait for the next run (bounds model spend).
SKOOLIE_INBOX_MAX=25
SKOOLIE_INBOX_MODEL=claude-sonnet-5
# From `claude setup-token`. Without it, messages are stored with a deterministic fallback summary
# instead of a model-written one.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional: campus staff-directory scripts (src/scripts/campus-*.ts) ------
# Your campus's Apptegy staff directory, e.g. https://example-ms.example-isd.org/staff
SKOOLIE_CAMPUS_STAFF_URL=
